# ==============================================================================
# Shivshree Agro Mart OS - Server Environment Configuration Template
# ==============================================================================
# Safe placeholder configuration only. NEVER commit real credentials to Git.
# Copy this file to '.env' and fill in your private local settings.

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI
# Intended Cluster Host: shivshreeagromart.kxglgqb.mongodb.net
# Intended Database: shivshree_agro_mart
# Placeholder format:
MONGODB_URI=mongodb+srv://<username>:<password>@shivshreeagromart.kxglgqb.mongodb.net/shivshree_agro_mart?retryWrites=true&w=majority

# Request Configuration
BODY_LIMIT=1mb
API_PREFIX=/api/v1

# Security & Authentication (Generate random 32+ char secrets for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Development-only bypass for customer SMS verification (Strictly disabled in production)
DEV_ALLOW_TEST_OTP=true

# SMS Gateway Configuration
# Options: mock | fast2sms | twilio
# Set to 'mock' by default (logs OTP to terminal and returns testNotice in dev mode)
# To send real SMS to mobile numbers in India, sign up at fast2sms.com and configure your API key:
SMS_PROVIDER=mock
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Or for Twilio international SMS carrier:
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890
