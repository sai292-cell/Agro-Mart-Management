# ==============================================================================
# Shivshree Agro Mart OS - Environment Configuration Example
# ==============================================================================
# NOTE: Copy this file to '.env' (or respective server/client .env files) 
# and fill in actual values. NEVER commit secrets or real credentials to Git.

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shivshree_agro_mart?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/shivshree_agro_mart

# Security & Authentication
# Generate a cryptographically secure random secret (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_min_32_characters_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Business Defaults
BUSINESS_NAME="Shivshree Agro Mart"
BUSINESS_STATE="Maharashtra"
BUSINESS_COUNTRY="India"
DEFAULT_CURRENCY="INR"
TIMEZONE="Asia/Kolkata"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# --- CLIENT CONFIGURATION (Vite) ---
# Vite requires environment variables exposed to client to be prefixed with VITE_
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="Shivshree Agro Mart OS"
VITE_DEFAULT_LANGUAGE=mr
